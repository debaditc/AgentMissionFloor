{
  "description": "AgentMissionFloor: forwards hook payloads to the local collector. Async and silent: Claude never waits and nothing enters its context. WorktreeCreate/WorktreeRemove are deliberately not hooked (a hook there replaces git's behaviour).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/amb-send",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/amb-send",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
