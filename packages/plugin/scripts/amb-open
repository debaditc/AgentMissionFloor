#!/bin/sh
# amb-open: opens the AgentMissionFloor board in the browser, starting the collector if needed.
# Signs the browser in with a one-time code (2 minutes, single use). The long-lived token is never
# printed or put in a URL, so it can't end up in a terminal log or in Claude's transcript.
# Settings: AMF_* first, then the original AMB_* names. Data lives in ~/.agent-mission-floor
# (or the pre-rename ~/.agent-mission-board until the collector migrates it).
default_home="$HOME/.agent-mission-floor"
[ -d "$default_home" ] || [ ! -d "$HOME/.agent-mission-board" ] || default_home="$HOME/.agent-mission-board"
AMB_HOME="${AMF_HOME:-${AMB_HOME:-$default_home}}"
here=$(cd "$(dirname "$0")" && pwd)
entry="${AMF_COLLECTOR_ENTRY:-${AMB_COLLECTOR_ENTRY:-$here/../../collector/src/main.ts}}"
[ -f "$entry" ] || entry="$(sed -n 's/.*"repo": *"\([^"]*\)".*/\1/p' "$AMB_HOME/install.json" 2>/dev/null)/packages/collector/src/main.ts"

base() { sed 's#/v1/hook$##' "$AMB_HOME/sender.url" 2>/dev/null; }

# Ours and alive: the pid in runtime.json is running and /health answers as this app.
alive() {
  pid=$(sed -n 's/.*"pid": *\([0-9][0-9]*\).*/\1/p' "$AMB_HOME/runtime.json" 2>/dev/null)
  [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null || return 1
  curl -sf --max-time 1 "$(base)/health" 2>/dev/null | grep -q '"app":"agent-mission-floor"'
}

if ! alive; then
  if command -v node >/dev/null 2>&1 && [ -f "$entry" ]; then
    nohup node --disable-warning=ExperimentalWarning "$entry" --quiet >/dev/null 2>&1 &
    i=0
    while [ $i -lt 40 ] && ! alive; do sleep 0.1; i=$((i + 1)); done
  fi
fi
if ! alive; then
  echo "The AgentMissionFloor collector isn't running and couldn't be started (it needs Node 22.18 or newer)." >&2
  exit 1
fi

code=$(curl -sf --max-time 2 -X POST -H @"$AMB_HOME/sender.headers" "$(base)/v1/login-code" | sed -n 's/.*"code":"\([A-Za-z0-9_-]*\)".*/\1/p')
if [ -z "$code" ]; then
  echo "Couldn't get a sign-in link from the collector. Try again, or restart it with: npm run open" >&2
  exit 1
fi
login="$(base)/login?code=$code"

if [ "${AMF_NO_BROWSER:-${AMB_NO_BROWSER:-0}}" = "1" ]; then
  # No browser here: print the one-time link (expires in 2 minutes, works once).
  echo "$login"
  exit 0
fi
if command -v open >/dev/null 2>&1; then open "$login"
elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$login" >/dev/null 2>&1 &
else echo "$login"; exit 0
fi
echo "Opened the board: $(base)/"
